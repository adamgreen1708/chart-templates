import pandas as pd

# Load data
df = pd.read_csv("data/uk-mean-temperature.csv")

# Sort descending by temperature
df_sorted = df.sort_values(
    by="Annual mean temperature (°C)",
    ascending=False
)

# Take top 20
top20 = df_sorted.head(20)

# Save
top20.to_csv("data/uk_mean_temperature_top20.csv", index=False)

print("Saved: data/uk_mean_temperature_top20.csv")